/*
| Tailwind v4 only scans files declared via @source for utility classes.
| The line below maps the package's blade partials (footer, sidebar-status,
| login, etc.) so utilities like flex/px-6/items-center used inside them
| are not purged from the final build.
*/
@source '../../../../vendor/jeffersongoncalves/filament-editorial-theme/resources/views';

